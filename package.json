{
  "name": "evolve-desk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "image-size": "file:vendor/image-size-safe",
      "nanoid@<3.3.18": "3.3.18",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  },
  "description": "A configurable personal workbench that evolves through reviewable AI agent proposals.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tabriage/EvolveDesk.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:site": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:agent": "node tools/evolve-agent-server.mjs",
    "broker:storage": "node tools/storage-credential-broker.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:evolution": "pnpm run lint && pnpm exec tsc --noEmit && pnpm test",
    "evolve:rollback": "node tools/evolve-rollback.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.30",
    "ai": "^7.0.52",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "image-size": "file:vendor/image-size-safe",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.119.0"
  },
  "type": "module"
}
